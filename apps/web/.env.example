# Web Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server-only API URL used by Server Components and server-side fetching.
# Not exposed to the browser bundle.
API_URL=http://localhost:4000

# Client-side API URL exposed to the browser bundle (prefixed with NEXT_PUBLIC_).
# Used when client components need to communicate directly with the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
