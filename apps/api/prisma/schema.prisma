// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SecurityTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OAuthAction {
  SIGNIN
  LINK
  REAUTH
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  role                Role                 @default(CUSTOMER)
  status              UserStatus           @default(ACTIVE)
  emailVerified       Boolean              @default(false)
  emailVerifiedAt     DateTime?
  profile             CustomerProfile?
  addresses           Address[]
  sessions            Session[]
  securityTokens      SecurityToken[]
  oauthAccounts       OAuthAccount[]
  oauthTransactions   OAuthTransaction[]
  oauthLinkChallenges OAuthLinkChallenge[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  divisionId    String
  districtId    String
  upazila       String
  streetAddress String
  postalCode    String?
  label         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime?
  revokedReason     String?
  reauthenticatedAt DateTime?
  expiresAt         DateTime
  lastUsedAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  refreshTokens     RefreshToken[]
  oauthTransactions OAuthTransaction[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  consumedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([familyId])
}

model SecurityToken {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       SecurityTokenType
  tokenHash  String            @unique
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // "google"
  providerAccountId String   // Google OpenID "sub"
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId], name: "unique_provider_account")
  @@index([userId])
}

model OAuthTransaction {
  id                    String      @id @default(cuid())
  stateHash             String      @unique
  statePrefix           String
  nonce                 String
  encryptedCodeVerifier String
  codeVerifierIv        String
  codeVerifierTag       String
  action                OAuthAction @default(SIGNIN)
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId             String?
  session               Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  returnUrl             String      @default("/account")
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime    @default(now())

  @@index([expiresAt])
  @@index([sessionId])
}

model OAuthLinkChallenge {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    // "google"
  providerAccountId String    // Google OpenID "sub"
  email             String
  challengeHash     String    @unique
  challengePrefix   String
  failedAttempts    Int       @default(0)
  consumedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([challengePrefix])
  @@index([expiresAt])
}
