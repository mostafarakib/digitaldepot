// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SecurityTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OAuthAction {
  SIGNIN
  LINK
  REAUTH
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  role                Role                 @default(CUSTOMER)
  status              UserStatus           @default(ACTIVE)
  emailVerified       Boolean              @default(false)
  emailVerifiedAt     DateTime?
  profile             CustomerProfile?
  addresses           Address[]
  sessions            Session[]
  securityTokens      SecurityToken[]
  oauthAccounts       OAuthAccount[]
  oauthTransactions   OAuthTransaction[]
  oauthLinkChallenges OAuthLinkChallenge[]
  priceHistories      PriceHistory[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  divisionId    String
  districtId    String
  upazila       String
  streetAddress String
  postalCode    String?
  label         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime?
  revokedReason     String?
  reauthenticatedAt DateTime?
  expiresAt         DateTime
  lastUsedAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  refreshTokens     RefreshToken[]
  oauthTransactions OAuthTransaction[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  consumedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([familyId])
}

model SecurityToken {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       SecurityTokenType
  tokenHash  String            @unique
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // "google"
  providerAccountId String   // Google OpenID "sub"
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId], name: "unique_provider_account")
  @@index([userId])
}

model OAuthTransaction {
  id                    String      @id @default(cuid())
  stateHash             String      @unique
  statePrefix           String
  nonce                 String
  encryptedCodeVerifier String
  codeVerifierIv        String
  codeVerifierTag       String
  action                OAuthAction @default(SIGNIN)
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId             String?
  session               Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  returnUrl             String      @default("/account")
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime    @default(now())

  @@index([expiresAt])
  @@index([sessionId])
}

model OAuthLinkChallenge {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    // "google"
  providerAccountId String    // Google OpenID "sub"
  email             String
  challengeHash     String    @unique
  challengePrefix   String
  failedAttempts    Int       @default(0)
  consumedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([challengePrefix])
  @@index([expiresAt])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  imageUrl     String?
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, displayOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  websiteUrl  String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([name])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  summary        String?
  description    String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  status         ProductStatus   @default(DRAFT)
  featured       Boolean         @default(false)
  warranty       String?
  specifications Json?           // Validated array of { group, name, value }
  publishedAt    DateTime?
  variants       ProductVariant[]
  images         ProductImage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?  // Cloudinary asset public_id
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String         @unique // Normalized uppercase
  name           String         // e.g. "Natural Titanium / 256GB" or "Default"
  price          Int            // Integer poisha: ৳1,000 = 100,000 poisha
  compareAtPrice Int?           // Optional strike-through price in poisha
  costPrice      Int?           // Optional wholesale cost in poisha
  barcode        String?
  attributes     Json           @default("{}") // e.g. { "Color": "Titanium", "Storage": "256GB" }
  isDefault      Boolean        @default(false)
  isActive       Boolean        @default(true)
  priceHistory   PriceHistory[]
  inventoryItem  InventoryItem?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([productId])
  @@index([productId, isDefault])
  @@index([isActive])
}

model PriceHistory {
  id              String         @id @default(cuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  oldPrice        Int            // Minor units (poisha)
  newPrice        Int            // Minor units (poisha)
  oldCompareAt    Int?
  newCompareAt    Int?
  oldCostPrice    Int?
  newCostPrice    Int?
  reason          String?        // Audit explanation
  changedByUserId String?
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([changedByUserId])
}

enum InventoryAdjustmentType {
  RECEIVE
  CORRECTION
  DAMAGE
  THEFT_LOSS
  RETURN_RESTOCK
}

model InventoryItem {
  id                String                @id @default(cuid())
  variantId         String                @unique
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int                   @default(0) // Physical on-hand stock
  reservedQuantity  Int                   @default(0) // Reserved by pending checkouts (Phase 6)
  lowStockThreshold Int?                  @default(5) // Threshold for low-stock alert
  adjustments       InventoryAdjustment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([variantId])
}

model InventoryAdjustment {
  id               String                  @id @default(cuid())
  inventoryItemId  String
  inventoryItem    InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  type             InventoryAdjustmentType
  quantityDelta    Int                     // Signed non-zero integer (+/-)
  oldQuantity      Int                     // On-hand stock before adjustment
  newQuantity      Int                     // On-hand stock after adjustment
  reason           String                  // Mandatory audit explanation
  adjustedByUserId String?
  adjustedByUser   User?                   @relation(fields: [adjustedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([adjustedByUserId])
  @@index([type])
}
