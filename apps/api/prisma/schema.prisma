// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/client"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SecurityTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OAuthAction {
  SIGNIN
  LINK
  REAUTH
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  role                Role                 @default(CUSTOMER)
  status              UserStatus           @default(ACTIVE)
  emailVerified       Boolean              @default(false)
  emailVerifiedAt     DateTime?
  profile             CustomerProfile?
  addresses           Address[]
  sessions            Session[]
  securityTokens      SecurityToken[]
  oauthAccounts       OAuthAccount[]
  oauthTransactions   OAuthTransaction[]
  oauthLinkChallenges OAuthLinkChallenge[]
  priceHistories      PriceHistory[]
  inventoryAdjustments InventoryAdjustment[]
  cart                Cart?
  couponUsages        CouponUsage[]
  orders              Order[]
  orderStatusHistories OrderStatusHistory[]
  wishlistItems       WishlistItem[]
  productReviews      ProductReview[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  divisionId    String
  districtId    String
  upazila       String
  streetAddress String
  postalCode    String?
  label         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime?
  revokedReason     String?
  reauthenticatedAt DateTime?
  expiresAt         DateTime
  lastUsedAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  refreshTokens     RefreshToken[]
  oauthTransactions OAuthTransaction[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  consumedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([familyId])
}

model SecurityToken {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       SecurityTokenType
  tokenHash  String            @unique
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // "google"
  providerAccountId String   // Google OpenID "sub"
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId], name: "unique_provider_account")
  @@index([userId])
}

model OAuthTransaction {
  id                    String      @id @default(cuid())
  stateHash             String      @unique
  statePrefix           String
  nonce                 String
  encryptedCodeVerifier String
  codeVerifierIv        String
  codeVerifierTag       String
  action                OAuthAction @default(SIGNIN)
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId             String?
  session               Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  returnUrl             String      @default("/account")
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime    @default(now())

  @@index([expiresAt])
  @@index([sessionId])
}

model OAuthLinkChallenge {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    // "google"
  providerAccountId String    // Google OpenID "sub"
  email             String
  challengeHash     String    @unique
  challengePrefix   String
  failedAttempts    Int       @default(0)
  consumedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([challengePrefix])
  @@index([expiresAt])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  imageUrl     String?
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, displayOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  websiteUrl  String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([name])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  summary        String?
  description    String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  status         ProductStatus   @default(DRAFT)
  featured       Boolean         @default(false)
  warranty       String?
  specifications Json?           // Validated array of { group, name, value }
  publishedAt    DateTime?
  variants       ProductVariant[]
  images         ProductImage[]
  wishlistItems  WishlistItem[]
  reviews        ProductReview[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?  // Cloudinary asset public_id
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String         @unique // Normalized uppercase
  name           String         // e.g. "Natural Titanium / 256GB" or "Default"
  price          Int            // Integer poisha: ৳1,000 = 100,000 poisha
  compareAtPrice Int?           // Optional strike-through price in poisha
  costPrice      Int?           // Optional wholesale cost in poisha
  barcode        String?
  attributes     Json           @default("{}") // e.g. { "Color": "Titanium", "Storage": "256GB" }
  isDefault      Boolean        @default(false)
  isActive       Boolean        @default(true)
  priceHistory   PriceHistory[]
  inventoryItem  InventoryItem?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([productId])
  @@index([productId, isDefault])
  @@index([isActive])
}

model PriceHistory {
  id              String         @id @default(cuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  oldPrice        Int            // Minor units (poisha)
  newPrice        Int            // Minor units (poisha)
  oldCompareAt    Int?
  newCompareAt    Int?
  oldCostPrice    Int?
  newCostPrice    Int?
  reason          String?        // Audit explanation
  changedByUserId String?
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([changedByUserId])
}

enum InventoryAdjustmentType {
  RECEIVE
  CORRECTION
  DAMAGE
  THEFT_LOSS
  RETURN_RESTOCK
  ORDER_FULFILLMENT
  ORDER_CANCELLATION
}

model InventoryItem {
  id                String                @id @default(cuid())
  variantId         String                @unique
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int                   @default(0) // Physical on-hand stock
  reservedQuantity  Int                   @default(0) // Reserved by pending checkouts (Phase 6)
  lowStockThreshold Int?                  @default(5) // Threshold for low-stock alert
  adjustments       InventoryAdjustment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([variantId])
}

model InventoryAdjustment {
  id               String                  @id @default(cuid())
  inventoryItemId  String
  inventoryItem    InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  type             InventoryAdjustmentType
  quantityDelta    Int                     // Signed non-zero integer (+/-)
  oldQuantity      Int                     // On-hand stock before adjustment
  newQuantity      Int                     // On-hand stock after adjustment
  reason           String                  // Mandatory audit explanation
  adjustedByUserId String?
  adjustedByUser   User?                   @relation(fields: [adjustedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([adjustedByUserId])
  @@index([type])
}

model Cart {
  id                String     @id @default(cuid())
  userId            String?    @unique // Authenticated customer cart (1:1)
  user              User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash    String?    @unique // SHA-256 hash of 256-bit opaque guest token
  couponId          String?
  coupon            Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  estimatedDistrict String?    // Normalized district ID (e.g. "DHAKA", "CHATTOGRAM") for delivery estimation
  items             CartItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
  @@index([guestTokenHash])
  @@index([couponId])
}

model CartItem {
  id             String         @id @default(cuid())
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int            @default(1)
  unitPriceAtAdd Int            // Informational snapshot in integer BDT poisha
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Int                // Percentage (1-100) or fixed amount in BDT poisha
  maxDiscountAmount Int?               // Max discount cap in BDT poisha (for percentage)
  minOrderAmount    Int?               // Minimum subtotal in BDT poisha
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?               // Global max usage count (null = unlimited)
  usageCount        Int                @default(0) // Tracked global usage
  perCustomerLimit  Int?               @default(1) // Max usage per customer (null = unlimited)
  isActive          Boolean            @default(true)
  usages            CouponUsage[]
  carts             Cart[]
  orders            Order[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([startDate, endDate])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?  // Reference to order
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  usedAt    DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@index([orderId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReview {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  rating             Int          // 1 to 5 integer
  title              String?      // Optional review headline (max 120 chars)
  comment            String       // Detailed feedback text (min 5, max 2000 chars)
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false) // Ready for Phase 6 order linkage
  moderatedAt        DateTime?
  moderatorId        String?      // Admin user ID who reviewed
  rejectionReason    String?      // Optional feedback note on rejection
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([userId])
  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
}

model Order {
  id                       String               @id @default(cuid())
  orderNumber              String               @unique // DD-YYYYMMDD-RANDOM8
  userId                   String
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                   OrderStatus          @default(PENDING)
  paymentStatus            PaymentStatus        @default(PENDING)
  paymentMethod            PaymentMethod

  // Financial Snapshot in integer BDT poisha
  merchandiseSubtotal      Int
  discountAmount           Int                  @default(0)
  shippingFee              Int
  totalPayable             Int

  // Delivery Address Snapshot
  shippingRecipientName    String
  shippingPhone            String
  shippingAlternativePhone String?
  shippingDivisionId       String
  shippingDistrictId       String
  shippingUpazila          String
  shippingStreetAddress    String
  shippingDeliveryNotes    String?

  // Coupon Snapshot
  couponId                 String?
  coupon                   Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode               String?
  couponDiscountType       CouponDiscountType?
  couponDiscountValue      Int?
  couponDiscountAmount     Int                  @default(0)

  // Online Payment Reservation Expiration (30-minute window for SSLCommerz)
  paymentExpiresAt         DateTime?

  // Cancellation Audit
  cancelledAt              DateTime?
  cancellationReason       String?

  // Relations
  items                    OrderItem[]
  payments                 Payment[]
  statusHistory            OrderStatusHistory[]
  couponUsages             CouponUsage[]

  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingDistrictId])
  @@index([status, paymentMethod, paymentExpiresAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Immutable Item Snapshot
  productName  String
  variantTitle String
  sku          String
  unitPrice    Int             // BDT poisha
  quantity     Int
  lineTotal    Int             // unitPrice * quantity
  attributes   Json?           // Variant attributes snapshot
  thumbnailUrl String?

  createdAt    DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                   String        @id @default(cuid())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactionId        String        @unique // Internal unique ref: TXN-YYYYMMDD-RANDOM8
  gatewayTransactionId String?       // SSLCommerz bank_tran_id / val_id
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Int           // BDT poisha
  currency             String        @default("BDT")
  gatewayResponse      Json?         // Full gateway audit payload
  paidAt               DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([orderId])
  @@index([gatewayTransactionId])
  @@index([status])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  reason          String?
  changedByUserId String?
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}



