# API Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Application
NODE_ENV=development
PORT=4000

# Database
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://digitaldepot_user:your_password_here@localhost:5432/digitaldepot"
TEST_DATABASE_URL="postgresql://digitaldepot_user:your_password_here@localhost:5432/digitaldepot_test"

# CORS — the frontend origin allowed to make requests to this API
FRONTEND_URL=http://localhost:3000

# Security Secrets (Must be at least 32 characters each)
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-secret-key-for-jwt-access-tokens
CSRF_SECRET=replace-with-at-least-32-chars-secret-key-for-csrf-signatures

# JWT Claims Configuration
JWT_ISSUER=https://api.digitaldepot.com
JWT_AUDIENCE=https://digitaldepot.com

# Cookie Configuration (Omit in development; set to .digitaldepot.com in production)
# COOKIE_DOMAIN=.digitaldepot.com

# Admin CLI Seed (Optional: password auto-generated if omitted)
ADMIN_INITIAL_EMAIL=admin@digitaldepot.local
# ADMIN_INITIAL_PASSWORD=at-least-16-characters-admin-password

# Trust Proxy (e.g. "loopback" or "1" for 1 hop reverse proxy)
TRUST_PROXY=loopback
