# API Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Application
NODE_ENV=development
PORT=4000

# Database
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://digitaldepot_user:your_password_here@localhost:5432/digitaldepot"
TEST_DATABASE_URL="postgresql://digitaldepot_user:your_password_here@localhost:5432/digitaldepot_test"

# CORS — the frontend origin allowed to make requests to this API
FRONTEND_URL=http://localhost:3000

# Security Secrets (Must be at least 32 characters each)
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-secret-key-for-jwt-access-tokens
CSRF_SECRET=replace-with-at-least-32-chars-secret-key-for-csrf-signatures

# JWT Claims Configuration
JWT_ISSUER=https://api.digitaldepot.com
JWT_AUDIENCE=https://digitaldepot.com

# Cookie Configuration (Omit in development; set to .digitaldepot.com in production)
# COOKIE_DOMAIN=.digitaldepot.com

# Admin CLI Seed (Optional: password auto-generated if omitted)
ADMIN_INITIAL_EMAIL=admin@digitaldepot.local
# ADMIN_INITIAL_PASSWORD=at-least-16-characters-admin-password

# Trust Proxy (e.g. "loopback" or "1" for 1 hop reverse proxy)
TRUST_PROXY=loopback

# Email Configuration
# EMAIL_PROVIDER: "console" (default for dev/test) or "resend" (production)
EMAIL_PROVIDER=console
EMAIL_FROM="DigitalDepot <noreply@digitaldepot.com>"
# RESEND_API_KEY=re_1234567890abcdef

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback
# 64 hexadecimal characters representing 32 bytes (generate with node -e "console.log(crypto.randomBytes(32).toString('hex'))")
OAUTH_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OAUTH_STATE_SECRET=replace-with-at-least-32-chars-secret-key-for-oauth-state

# API Base URL (used for payment gateway return callbacks)
API_BASE_URL=http://localhost:4000

# SSLCommerz Payment Gateway Configuration
SSLCOMMERZ_STORE_ID=digitaldepot_sandbox_store
SSLCOMMERZ_STORE_PASSWORD=digitaldepot_sandbox_password
SSLCOMMERZ_IS_SANDBOX=true


